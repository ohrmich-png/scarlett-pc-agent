# Copy this file to "agent.env" (same folder as pc-agent.py)
# and paste your token below. Never share this file.

# Fine-grained Personal Access Token (classic tokens also work).
# Create one at: https://github.com/settings/tokens?type=beta
#   - Token name: scarlett-pc-agent
#   - Expiration: 90 days (renew when it expires)
#   - Repository access: "Only select repositories" -> scarlett-pc-bridge
#   - Permissions -> Repository permissions -> Contents: Read and write
GITHUB_TOKEN=PASTE_YOUR_TOKEN_HERE

# You shouldn't need to change this:
BRIDGE_REPO=ohrmich-png/scarlett-pc-bridge

# Machine name: this agent only runs commands tagged for this machine.
# Use a different name on each computer (e.g. desktop on your PC,
# laptop on your laptop) so both agents can stay live at once.
MACHINE=desktop
