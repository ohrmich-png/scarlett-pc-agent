# Scarlett PC agent config — LAPTOP copy.
# 1. Open agent.env on your PC, copy the long token after GITHUB_TOKEN=,
#    and paste it below (replacing PASTE_TOKEN_FROM_YOUR_PC_HERE).
# 2. Save this file as "agent.env" next to pc-agent.py on the laptop.
# Never share this file.

GITHUB_TOKEN=PASTE_TOKEN_FROM_YOUR_PC_HERE
BRIDGE_REPO=ohrmich-png/scarlett-pc-bridge
MACHINE=laptop
